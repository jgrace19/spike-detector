# Required for POST /alert and POST /metrics. Header X-Observability-Token.
OBSERVABILITY_SHARED_SECRET=

# Written by `bdk slack create` when the demo Slack workspace is ready.
SPIKE_DETECTOR_SLACK_BOT_TOKEN=
SPIKE_DETECTOR_SLACK_APP_TOKEN=

# Channel the bot pages (id C… or #name) and the code owner (Slack member id U…).
SPIKE_DETECTOR_SLACK_CHANNEL=
SPIKE_DETECTOR_CODE_OWNER_SLACK_ID=

# Optional override for the cloud agent starting ref and fix PR base.
# Defaults to demo/base on jgrace19/marketplace.
MARKETPLACE_STARTING_REF=demo/base

# Optional Linear project in the fe-demo workspace. Defaults to Marketplace.
LINEAR_PROJECT=Marketplace

# Personal API key created in the fe-demo Linear workspace.
# Sent as Authorization: Bearer ${LINEAR_TOKEN} to https://mcp.linear.app/mcp.
LINEAR_TOKEN=
